<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Shot Caller</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_shotcaller._tcp</string>
		<string>_shotcaller._udp</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Shot Caller uses Bluetooth to find a nearby camera or remote and send camera controls between your devices.</string>
	<key>NSCameraUsageDescription</key>
	<string>Shot Caller uses this device's camera to take photos and videos when you or your paired remote press the shutter.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Shot Caller connects your nearby devices over Wi-Fi to transfer photos and videos faster.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Shot Caller uses the microphone to record sound when you record a video on this device.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Shot Caller saves photos and videos you take or receive to your Photos library. It cannot read your existing photos.</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>WiFiAwareServices</key>
	<dict>
		<key>_shotcaller._udp</key>
		<dict>
			<key>Publishable</key>
			<dict/>
			<key>Subscribable</key>
			<dict/>
		</dict>
	</dict>
</dict>
</plist>
